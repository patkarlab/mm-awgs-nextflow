{#
  copy_number_tab.html.j2

  Depth-based copy number from ichorCNA, by way of ichorkaryo.

  Distinct from the ichorCNA tab. That one reads ichorCNA's own output for the
  tumour-fraction panel; this is the derived karyotype: arm calls against the
  genome's modal copy number, an ISCN string, a cytoband table, and a cell
  fraction per event that is directly comparable to interphase FISH
  percentages, with an explicit detection limit so a negative means something.

  Allele-specific copy number is absent. ichorCNA is depth-only and cannot
  separate 2:0 from 1:1, and allelic state is now measured at the eight wide
  panel windows rather than genome-wide. Purity comes from flow cytometry or
  not at all; ichorCNA's own fitted fraction is shown separately as CNA
  burden, because on sorted plasma cells it measures copy-number deviation
  rather than how much tumour is present.

  Context required:
    copy_number - output of parsers/copy_number.py (or None)
    sample      - sequencing identifier

  Include inside the tab-content container of sample_report.html.j2.
#}
{#
  Resolves its context under either convention, as ichor_tab does: this builder
  passes the per-sample context as a single `ctx` object, so a bare variable
  name is undefined and every guard falls through to the empty state.
#}
{% set cn = copy_number if (copy_number is defined and copy_number) else ((ctx.copy_number if ctx is defined else none) or none) %}
{% set sample = sample if (sample is defined and sample) else ((ctx.sample if ctx is defined else none) or '') %}
<div class="tab-pane fade" id="tab-copy-number" role="tabpanel">

  {% if not cn %}
    <div class="alert alert-danger mt-3">
      <strong>Context not supplied.</strong>
      The builder did not pass <code>copy_number</code> into this template,
      under either <code>copy_number</code> or <code>ctx.copy_number</code>.
      Check that <code>build.py</code> assigns <code>ctx["copy_number"]</code>
      and that render() passes it through.
    </div>

  {% elif not cn.found %}
    <div class="alert alert-secondary mt-3">
      <strong>No copy number output found.</strong>
      Expected <code>&lt;sample&gt;.ichorkaryo.json</code> under
      <code>copy_number/</code>.
      <div class="small text-muted mt-1">Searched: <code>{{ cn.searched }}</code></div>
    </div>

  {% else %}

    <div class="d-flex align-items-baseline justify-content-between mt-3 mb-2">
      <div>
        <h5 class="mb-0">Copy number &amp; allelic state</h5>
        <small class="text-muted">
          ichorCNA depth from off-target reads against GRCh38
          {% if cn.headline.baseline_cn is not none %}
            &middot; baseline CN <strong>{{ cn.headline.baseline_cn }}</strong>
          {% endif %}
          {% if cn.headline.cna_burden is not none %}
            &middot; CNA burden {{ '%.3f'|format(cn.headline.cna_burden) }}
          {% endif %}
          {% if cn.headline.purity is not none %}
            &middot; purity <strong>{{ '%.2f'|format(cn.headline.purity) }}</strong>
            <span class="{{ 'text-success' if cn.headline.purity_supplied else 'text-warning' }}">
              ({{ cn.headline.purity_source }})
            </span>
          {% endif %}
          {% if cn.headline.ploidy is not none %}
            &middot; ploidy <strong>{{ '%.2f'|format(cn.headline.ploidy) }}</strong>
          {% endif %}
          {% if cn.headline.sex %}&middot; {{ cn.headline.sex }}{% endif %}
        </small>
      </div>
    </div>

    {% for warning in cn.warnings %}
      <div class="alert alert-warning py-2 small">{{ warning }}</div>
    {% endfor %}

    {#
      ISCN carries a copy button rather than an Include checkbox.
      render_cnv_plot_card stores a path and the Reporting tab renders it as an
      image, so a text entry pushed through the same keys would come back
      broken. This is the line that gets pasted into the clinical report, so
      what it needs is the clipboard.
    #}
    {% if cn.headline.iscn %}
      <div class="card mb-3">
        <div class="card-body py-2">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="small text-muted">ISCN</div>
            <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                    id="cn-iscn-copy" data-cn-iscn="{{ cn.headline.iscn }}">
              Copy
            </button>
          </div>
          <code id="cn-iscn-text" style="font-size:0.95rem">{{ cn.headline.iscn }}</code>
          {#
            A boolean here fired on near-triploid genomes, where every
            chromosome at three copies is the baseline rather than a gain.
            The class distinguishes them; the chromosome count is what the
            48-to-75 convention actually refers to.
          #}
          {% if cn.headline.ploidy_class %}
            {% set badges = {
              'hyperdiploid':     ('bg-danger',    'Hyperdiploid'),
              'near_triploid':    ('bg-warning text-dark', 'Near-triploid'),
              'near_tetraploid':  ('bg-warning text-dark', 'Near-tetraploid'),
              'hypodiploid':      ('bg-danger',    'Hypodiploid'),
              'non_hyperdiploid': ('bg-secondary', 'Non-hyperdiploid'),
              'indeterminate':    ('bg-secondary', 'Ploidy indeterminate'),
            } %}
            {% set badge = badges.get(cn.headline.ploidy_class,
                                      ('bg-secondary', cn.headline.ploidy_class)) %}
            <div class="mt-2">
              <span class="badge {{ badge[0] }}">{{ badge[1] }}</span>
              {% if cn.headline.chromosome_count %}
                <span class="small text-muted ms-1">
                  {{ cn.headline.chromosome_count }} chromosomes
                </span>
              {% endif %}
              {% if cn.headline.trisomies %}
                <span class="small text-muted ms-1">
                  &middot; at three copies:
                  {{ cn.headline.trisomies | join(', ') }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {#
      Detection limit first. It is what makes a negative interpretable: if it
      sits above the FISH percentage being compared against, the comparison is
      not yet meaningful and no amount of reading the figure will fix that.
    #}
    <div class="row g-2 mb-3">
      {% set cards = [
        ('Detection limit, 5 Mb',
         (cn.qc.detection_limit_5mb * 100) | round(1) ~ '%' if cn.qc.detection_limit_5mb is not none else '&ndash;',
         'smallest single-copy change detectable, as a fraction of cells'),
        ('Reads per bin',
         cn.qc.median_reads_per_bin if cn.qc.median_reads_per_bin is not none else '&ndash;',
         ('median, off-target, ' ~ (cn.qc.bin_size // 1000) ~ ' kb bins')
           if cn.qc.bin_size else 'median, off-target'),
        ('Overdispersion',
         (cn.qc.overdispersion ~ '&times;') if cn.qc.overdispersion is not none else '&ndash;',
         ('near 1 is counting-limited; raw counts ' ~ cn.qc.overdispersion_raw ~ '&times;')
           if cn.qc.overdispersion_raw is not none
           else 'observed noise over the Poisson floor'),
        ('Segments', cn.headline.n_segments if cn.headline.n_segments is not none else '&ndash;', ''),
      ] %}
      {% for label, value, note in cards %}
        <div class="col-6 col-lg-3">
          <div class="card h-100">
            <div class="card-body py-2">
              <div class="small text-muted">{{ label }}</div>
              <div class="fs-5">{{ value | safe }}</div>
              {% if note %}<div class="small text-muted">{{ note }}</div>{% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if cn.figures.genome %}
      <div class="row g-3 mb-3">
        {{ macros.render_cnv_plot_card('copy_number::genome',
             'Genome-wide copy number and allele fraction',
             cn.figures.genome, 'col-12') }}
      </div>
      <div class="small text-muted mb-3">
        ichorCNA bins the genome without masking the panel, so calls inside the
        target regions are made on the same footing as the rest. The log2 panel
        is referenced to this sample&rsquo;s own baseline copy number, not to a
        diploid genome.
      </div>
    {% endif %}

    {#
      Chromosome pages rather than the grid. The grid is a genome overview and
      gets crowded at 24 cells; these are what a reader opens to look at a
      specific event, at full width with gene highlight bands, the panel
      targets track and a labelled cytogram.

      Every page stays in the DOM and is shown or hidden by the pager, so the
      Include checkboxes are all registered on load regardless of which page is
      visible.
    #}
    {% if cn.chromosomes %}
      <h6 class="mt-4">Chromosome pages ({{ cn.chromosomes | length }})</h6>
      <p class="small text-muted mb-2">
        Depth, allele fraction and copy number per chromosome. Tick
        <em>Include</em> on any page to carry it into the Reporting tab.
      </p>
      <nav class="mb-3" id="cn-chr-pager">
        {% for page in cn.chromosomes %}
          <button type="button"
                  class="btn btn-sm {{ 'btn-primary' if loop.first else 'btn-outline-primary' }} me-1 mb-1 cn-chr-btn"
                  data-cn-chr="{{ page.chrom }}">{{ page.label }}</button>
        {% endfor %}
      </nav>
      {% set al = ctx.allelic if ctx.allelic is defined else none %}
      {% for page in cn.chromosomes %}
        <div class="row g-3 cn-chr-page" data-cn-page="{{ page.chrom }}"
             {% if not loop.first %}style="display:none"{% endif %}>
          {{ macros.render_cnv_plot_card('copy_number::' ~ page.chrom,
               page.chrom, page.src, 'col-12') }}
          {# ---- panel windows on this chromosome: depth, copy number, allelic state (allelic_tab_v1) ---- #}
          {% set ch = (al.chromosomes.get(page.chrom) if (al and al.found) else none) %}
          <div class="col-12">
            {% if ch and ch.windows %}
              <table class="table table-sm small align-middle mb-1">
                <thead><tr>
                  <th>Panel window</th><th>Band</th><th class="text-end">Size</th>
                  <th class="text-end" title="median log2 of on-target 1 kb bins vs the sample's diploid level">Depth log2 (on-target)</th>
                  <th title="ichorCNA state at the window, off-target reads">Copy number</th>
                  <th title="cell fraction from flow purity">Cell fraction</th>
                  <th>Allelic state</th><th class="text-end">Hets / usable</th><th>Reading</th>
                  <th title="tick to include this window in the Reporting tab">Include</th>{# rx_include_v2 #}
                </tr></thead>
                <tbody>
                {% for w in ch.windows %}
                  <tr class="{{ 'table-warning' if w.reading in ('deletion','copy-neutral LOH','gain (allelic)') else '' }}{% if w.svg %} cn-win-row{% endif %}"
                      {% if w.svg %}data-cn-win="{{ page.chrom }}-{{ loop.index }}" style="cursor:pointer" title="click for the depth and allele-fraction plot"{% endif %}>
                    <td><strong>{{ w.gene }}</strong>{% if w.svg %} <span class="text-muted small">&#9656; plot</span>{% endif %}</td>
                    <td class="text-muted">{{ w.band }}</td>
                    <td class="text-end text-muted">{{ '%.0f kb'|format(w.size_kb) if w.size_kb < 1000 else '%.2f Mb'|format(w.size_kb/1000) }}</td>
                    <td class="text-end">{{ '%.2f'|format(w.log2_ontarget) if w.log2_ontarget is not none else '' }}</td>
                    <td>{{ w.cn if w.cn is not none else '' }}
                      {% if w.cn_event and w.cn_event != 'none' %}<span class="badge bg-{{ 'danger' if w.cn_event == 'loss' else 'success' }} ms-1">{{ w.cn_event }}</span>{% endif %}</td>
                    <td>{{ '%.0f%%'|format(w.cell_fraction*100) if w.cell_fraction is not none else '' }}</td>
                    <td>
                      {% if w.allelic_state == 'balanced' %}<span class="badge bg-success">balanced</span>
                      {% elif w.allelic_state == 'imbalanced' %}<span class="badge bg-danger">imbalanced</span>
                      {% elif w.allelic_state == 'insufficient' %}<span class="badge bg-secondary">insufficient</span>
                      {% else %}<span class="text-muted">not assessed{% if w.baf_scope == 'excluded_ig' %} (Ig locus){% endif %}</span>{% endif %}
                    </td>
                    <td class="text-end text-muted">{% if w.n_usable %}{{ w.n_het }} / {{ w.n_usable }}{% endif %}</td>
                    <td>{{ w.reading }}</td>
                    <td class="text-center">
                      <input type="checkbox" class="form-check-input cn-win-include" title="include in the Reporting tab"
                             data-win-id="{{ w.chrom }}:{{ w.gene }}" data-gene="{{ w.gene }}" data-chrom="{{ w.chrom }}" data-band="{{ w.band }}"
                             data-log2="{{ '%.2f'|format(w.log2_ontarget) if w.log2_ontarget is not none else '' }}"
                             data-cn="{{ w.cn if w.cn is not none else '' }}{% if w.cn_event and w.cn_event != 'none' %} ({{ w.cn_event }}){% endif %}"
                             data-cf="{{ '%.0f%%'|format(w.cell_fraction*100) if w.cell_fraction is not none else '' }}"
                             data-state="{{ w.allelic_state or 'not assessed' }}" data-hets="{% if w.n_usable %}{{ w.n_het }} / {{ w.n_usable }}{% endif %}"
                             data-reading="{{ w.reading }}" data-svg-id="{% if w.svg %}cn-win-svg-{{ page.chrom }}-{{ loop.index }}{% endif %}">
                    </td>
                  </tr>
                  {% if w.svg %}
                    <tr class="cn-win-plot" data-cn-win-plot="{{ page.chrom }}-{{ loop.index }}" style="display:none">
                      <td colspan="10" class="bg-white"><div id="cn-win-svg-{{ page.chrom }}-{{ loop.index }}">{{ w.svg | safe }}</div>
                        {# allelic_gene_track_v1: swatch legend and reading guide #}
                        <div class="small text-muted mt-1">
                          <span class="me-3"><span style="display:inline-block;width:14px;height:3px;background:#1F3B73;vertical-align:middle"></span> depth log2, 1 kb bin</span>
                          {% if w.genes_in_window %}<span class="me-3"><span style="display:inline-block;width:14px;height:9px;background:#2e7d32;vertical-align:middle"></span> gene body</span>{% endif %}
                          <span class="me-3"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#b91c1c;vertical-align:middle"></span> heterozygous SNP (allele fraction 0.15&ndash;0.85)</span>
                          <span class="me-3"><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#888;vertical-align:middle"></span> homozygous SNP (near 0 or 1; carries no allelic information)</span>
                        </div>
                        <div class="small text-muted">
                          Only the red sites report allelic state. <strong>Balanced diploid:</strong> one red band at 0.5, depth flat.
                          <strong>Deletion:</strong> band splits symmetrically about 0.5, depth falls.
                          <strong>Copy-neutral LOH:</strong> band splits, depth flat.
                          <strong>Gain:</strong> band splits to 1/3 and 2/3, depth rises.
                          Separation grows with the fraction of cells carrying the event; near 100% the red sites reach the grey lines.
                          Runs of grey-only sites are haplotype blocks, not LOH.
                        </div>
                      </td>
                    </tr>
                  {% endif %}
                {% endfor %}
                </tbody>
              </table>
              {% if ch.arms %}
                <div class="small text-muted mb-2">
                  {% for a in ch.arms %}
                    <span class="me-3"><strong>{{ a.arm }} arm test:</strong>
                      {% if a.verdict.startswith('not_assessed') %}not run &mdash; only {{ a.genes }} is assessed on this arm ({{ '%.1f'|format(((a.span_end or 0) - (a.span_start or 0)) / 1e6) }} of {{ '%.1f'|format((a.arm_bp or 0) / 1e6) }} Mb); read that window's own allelic state above
                      {% else %}{{ a.verdict | replace('_', ' ') }}{% if a.p_value is not none %} (p {{ '%.2g'|format(a.p_value) }}){% endif %}
                      &middot; {{ a.n_windows }} windows ({{ a.genes }}) covering {{ '%.1f%%'|format((a.covered_fraction or 0)*100) }} of the arm across {{ '%.0f%%'|format((a.span_fraction or 0)*100) }} of its length{% endif %}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
            {% elif al and al.found %}
              <div class="small text-muted mb-2">No panel windows on this chromosome.</div>
            {% else %}
              <div class="small text-muted mb-2">Allelic-state output (genebaf) not present in this bundle.</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
      {% if al and al.found %}
        <details class="mb-2">
          <summary class="small">How to read the window table</summary>
          <div class="small text-muted mt-1" style="max-width:1100px">
            {% for head, text in al.reading %}<p class="mb-1"><strong>{{ head }}.</strong> {{ text }}</p>{% endfor %}
            <p class="mb-1">Allelic state is measured at {{ al.n_assessed }} of {{ al.n_windows }} windows{% if al.scope.assessed_windows %}: {{ al.scope.assessed_windows | join(', ') }}{% endif %}.</p>
          </div>
        </details>
      {% endif %}
    {% endif %}

    {% if cn.figures.grid %}
      <details class="mt-3 mb-3">
        <summary class="small text-muted">All chromosomes at once (overview grid)</summary>
        <div class="row g-3 mt-1">
          {{ macros.render_cnv_plot_card('copy_number::grid',
               'Per-chromosome overview grid', cn.figures.grid, 'col-12') }}
        </div>
      </details>
    {% endif %}

    {% if cn.cytobands %}
      <details class="mt-3 mb-3">
      <summary class="small text-muted">Altered cytobands ({{ cn.cytobands | length }}) — the vocabulary of the cytogenetics report</summary>
      <div class="small text-muted mb-2 mt-2">
        Copy number by band, in the vocabulary the cytogenetics report uses.
        Cell fraction is comparable to the percentage of nuclei scored positive
        by interphase FISH. It is blank where a single-copy change on a diploid
        background cannot explain the depth, in which case read implied copies.
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-striped datatable">
          <thead>
            <tr>
              <th>Band</th><th>Region</th><th>Copy number</th>
              <th>Implied copies</th><th>Event</th>
              <th>Cell fraction</th><th>Detection limit</th>
            </tr>
          </thead>
          <tbody>
            {% for band in cn.cytobands %}
              <tr>
                <td><strong>{{ band.cytoband }}</strong></td>
                <td class="small text-muted">
                  {{ band.chromosome }}:{{ band.start }}-{{ band.end }}
                </td>
                <td>{{ band.copy_number }}</td>
                <td>{{ band.implied_copies if band.implied_copies is not none else '' }}</td>
                <td>
                  <span class="badge bg-{{ 'danger' if band.event == 'loss' else 'success' }}">
                    {{ band.event }}
                  </span>
                </td>
                {#
                  These arrive from JSON rather than a TSV, so a missing value
                  is null and renders as the string None unless it is guarded.
                  Blank is what a reader should see: not measurable here.
                #}
                <td>{{ '%.0f%%'|format(band.cell_fraction * 100)
                       if band.cell_fraction is not none else '' }}</td>
                <td class="small text-muted">{{ '%.1f%%'|format(band.detection_limit * 100)
                       if band.detection_limit is not none else '' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </details>
    {% endif %}

    {% if ctx.ichor_sol_pages %}
      <details class="mt-3">
        <summary class="small text-muted">ichorCNA fit ({{ ctx.ichor_sol_pages | length }} solution page{{ '' if ctx.ichor_sol_pages | length == 1 else 's' }}; cellularity from flow, ploidy pinned at 2, so one solution)</summary>
        <div class="row g-3 mt-1">
          {% for pg in ctx.ichor_sol_pages %}
            {{ macros.render_cnv_plot_card('ichor::' ~ pg.name, pg.label, pg.path, 'col-12') }}
          {% endfor %}
        </div>
      </details>
    {% endif %}

    {% if cn.arms %}
      <details class="mt-3">
        <summary class="small text-muted">Arm-level summary</summary>
        <div class="small text-muted mt-2">
          Each arm takes the length-weighted majority call of the segments
          across it. Where <em>Arm covered</em> is well below 100% the call
          describes part of the arm only, and the cytoband table above is the
          finer view.
        </div>
        <div class="table-responsive mt-2">
          <table class="table table-sm table-striped">
            <thead>
              <tr>
                <th>Arm</th><th>log2</th><th>Copy number</th>
                <th>Event</th><th>Cell fraction</th><th>Arm covered</th>
              </tr>
            </thead>
            <tbody>
              {% for arm in cn.arms %}
                <tr>
                  <td>{{ arm.arm }}</td>
                  <td>{{ arm.log2_ratio if arm.log2_ratio is not none else '' }}</td>
                  <td>{{ arm.copy_number if arm.copy_number is not none else '' }}</td>
                  <td>{{ arm.event }}</td>
                  <td>{{ '%.0f%%'|format(arm.cell_fraction * 100)
                         if arm.cell_fraction is not none else '' }}</td>
                  {#
                    Arms are called by length-weighted majority, so a call can
                    cover only part of the arm. On 11F20265231 1p reads as copy
                    number 3 while a 35 Mb deletion inside it is at 1. This is
                    the column that makes that visible.
                  #}
                  <td class="small {{ 'text-warning' if arm.arm_fraction is not none
                                      and arm.arm_fraction < 0.8 else 'text-muted' }}">
                    {{ '%.0f%%'|format(arm.arm_fraction * 100)
                       if arm.arm_fraction is not none else '' }}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    {% endif %}

  {% endif %}

  {# Scoped to this tab: the pager ids and classes are prefixed cn- so they
     cannot collide with the shared vb-cnv- include machinery. #}
  <script>
  (function () {
    // rx_include_v2: window Include boxes, backed by the Reporting store.
    // Waits for load: the store is defined by a script at the end of body.
    window.addEventListener("load", function () {
      var store = window.tspipeReporting;
      if (!store) { return; }
      function snapshotOf(box) {
        var s = {};
        ["gene", "chrom", "band", "log2", "cn", "cf", "state", "hets", "reading"].forEach(function (k) {
          s[k] = box.getAttribute("data-" + k) || "";
        });
        s.svg_id = box.getAttribute("data-svg-id") || "";
        return s;
      }
      function sync() {
        var ids = {};
        store.load().forEach(function (it) { if (it.kind === "allelic_window") { ids[it.id] = true; } });
        document.querySelectorAll(".cn-win-include").forEach(function (box) {
          var on = !!ids[box.getAttribute("data-win-id")];
          if (box.checked !== on) { box.checked = on; }
        });
      }
      document.addEventListener("change", function (e) {
        var box = e.target.closest ? e.target.closest(".cn-win-include") : null;
        if (!box) { return; }
        store.toggle("allelic_window", box.getAttribute("data-win-id"), snapshotOf(box));
      });
      store.onChange(sync);
      sync();
    });

    document.addEventListener("click", function (event) {
      if (event.target.closest && event.target.closest("input")) { return; }
      var row = event.target.closest ? event.target.closest(".cn-win-row") : null;
      if (!row) { return; }
      var id = row.getAttribute("data-cn-win");
      var plot = document.querySelector('.cn-win-plot[data-cn-win-plot="' + id + '"]');
      if (plot) { plot.style.display = plot.style.display === "none" ? "" : "none"; }
    });
    var pager = document.getElementById("cn-chr-pager");
    if (pager) {
      pager.addEventListener("click", function (event) {
        var button = event.target.closest(".cn-chr-btn");
        if (!button) { return; }
        var wanted = button.getAttribute("data-cn-chr");
        document.querySelectorAll(".cn-chr-btn").forEach(function (b) {
          var active = b.getAttribute("data-cn-chr") === wanted;
          b.classList.toggle("btn-primary", active);
          b.classList.toggle("btn-outline-primary", !active);
        });
        document.querySelectorAll(".cn-chr-page").forEach(function (p) {
          p.style.display =
            (p.getAttribute("data-cn-page") === wanted) ? "" : "none";
        });
      });
    }

    var copy = document.getElementById("cn-iscn-copy");
    if (copy) {
      copy.addEventListener("click", function () {
        var text = copy.getAttribute("data-cn-iscn") || "";
        var done = function () {
          var previous = copy.textContent;
          copy.textContent = "Copied";
          setTimeout(function () { copy.textContent = previous; }, 1200);
        };
        // navigator.clipboard needs a secure context, which file:// is not, so
        // the textarea fallback is the path this usually takes.
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done, function () {});
          return;
        }
        var scratch = document.createElement("textarea");
        scratch.value = text;
        scratch.setAttribute("readonly", "");
        scratch.style.position = "absolute";
        scratch.style.left = "-9999px";
        document.body.appendChild(scratch);
        scratch.select();
        try { document.execCommand("copy"); done(); } catch (e) {}
        document.body.removeChild(scratch);
      });
    }
  })();
  </script>
</div>
