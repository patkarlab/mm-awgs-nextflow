{#
  rearrangements_tab.html.j2

  Rearrangements tab, replacing translocations_tab.html.j2.

  Three levels: event group (anchor locus) > partner locus (one window on
  each chromosome) > breakend. The partner locus is the row a reader sees;
  breakends open beneath it. Two tables with the same layout: reportable,
  then everything else. A reading key and a column key sit above, collapsed.

  Context: ctx.rearrangements from parsers/rearrangements.py.
#}
{% set rx = ctx.rearrangements %}
<div class="tab-pane fade" id="tab-translocations" role="tabpanel">

  {% if not rx or not rx.found %}
    <div class="alert alert-secondary mt-3">
      <strong>No rearrangement table found.</strong>
      {{ rx.reason if rx else '' }}
      <div class="small text-muted mt-1">Searched: <code>{{ rx.searched if rx else '' }}</code></div>
    </div>
  {% else %}

  {% set s = rx.summary %}
  <div class="d-flex align-items-baseline justify-content-between mt-3 mb-2 flex-wrap gap-2">
    <div>
      <h5 class="mb-0">Rearrangements</h5>
      <small class="text-muted">
        {{ s.n_junctions }} junctions in {{ s.n_loci }} partner loci, from {{ s.n_all_svs }} structural variants
        &middot; T2T-CHM13v2.0 &middot; Sniffles, CuteSV, Severus, SAVANA{% if s.has_nanomonsv %} + nanomonsv confirmation{% endif %}
        &middot; source <code>{{ rx.filename }}</code>
      </small>
    </div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-6 col-md-2"><div class="tspipe-card"><div class="label">Reportable loci</div><div class="value">{{ s.n_reportable }}</div></div></div>
    <div class="col-6 col-md-3"><div class="tspipe-card"><div class="label">Defining</div><div class="value" style="font-size:1.1rem">{{ s.defining_names | join(', ') if s.defining_names else 'none' }}</div></div></div>
    <div class="col-6 col-md-2"><div class="tspipe-card"><div class="label">nanomonsv confirmed</div><div class="value">{{ s.n_confirmed }}</div></div></div>
    <div class="col-6 col-md-2"><div class="tspipe-card"><div class="label">Multi-partner groups</div><div class="value">{{ s.n_groups_multi }}</div></div></div>
    <div class="col-6 col-md-2"><div class="tspipe-card"><div class="label">Flagged loci</div><div class="value">{{ s.n_flagged }}</div></div></div>
  </div>

  <details class="mb-2">
    <summary class="small">How to read this table</summary>
    <div class="small text-muted mt-2" style="max-width:1100px">
      {% for head, text in rx.reading_key %}
        <p class="mb-1"><strong>{{ head }}.</strong> {{ text }}</p>
      {% endfor %}
    </div>
  </details>
  <details class="mb-3">
    <summary class="small">Column key</summary>
    <table class="table table-sm table-borderless small mb-0" style="max-width:1100px">
      <tbody>
        {% for head, text in rx.column_key %}
          <tr><td class="text-nowrap"><code>{{ head }}</code></td><td>{{ text }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </details>
  {# rx_detail_key_v1 #}
  <details class="mb-3">
    <summary class="small">Detail field key &mdash; the fields shown when a locus row is opened</summary>
    <table class="table table-sm table-borderless small mb-0" style="max-width:1100px">
      <tbody>
        {% for head, text in rx.detail_key %}
          <tr><td class="text-nowrap"><code>{{ head }}</code></td><td>{{ text }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </details>

  {# ---- filters ---- #}
  <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small" id="rx-filters">
    <span class="text-muted">Show:</span>
    <div class="btn-group btn-group-sm" role="group">
      <button type="button" class="btn btn-outline-secondary active" data-rx-view="reportable">Reportable</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-view="defining">Defining only</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-view="confirmed">nanomonsv confirmed</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-view="all">All loci</button>
    </div>
    <span class="text-muted ms-2">Min callers</span>
    <div class="btn-group btn-group-sm" role="group" id="rx-min-callers">
      <button type="button" class="btn btn-outline-secondary active" data-rx-min="1">1</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-min="2">2</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-min="3">3</button>
    </div>
    <span class="text-muted ms-2">Min reads</span>
    <div class="btn-group btn-group-sm" role="group" id="rx-min-reads">
      <button type="button" class="btn btn-outline-secondary active" data-rx-min="0">any</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-min="3">3</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-min="5">5</button>
      <button type="button" class="btn btn-outline-secondary" data-rx-min="10">10</button>
    </div>
    {# rx_include_v1 #}
    <button type="button" class="btn btn-sm btn-outline-primary ms-2" id="rx-include-reportable" title="tick every reportable locus for the Reporting tab">Include all reportable</button>
    <span class="text-muted ms-auto" id="rx-count"></span>
  </div>

  {% macro locus_row(l, g, table, idx) %}
    {% set lid = table ~ '-' ~ idx %}
    <tr class="rx-locus" data-rx-id="{{ lid }}" style="cursor:pointer" title="click for details" data-reportable="{{ 1 if l.reportable else 0 }}" data-defining="{{ 1 if l.tier.startswith('defining') else 0 }}"
        data-confirmed="{{ 1 if l.nano == 'yes' else 0 }}" data-callers="{{ l.n_callers }}" data-reads="{{ l.reads or 0 }}" data-flag="{{ 1 if l.flag else 0 }}">
      <td class="text-nowrap">
        {% if l.n_breakends > 1 %}
          <button type="button" class="btn btn-sm btn-link p-0 rx-toggle" data-rx-target="{{ lid }}" title="show breakends">&#9654; {{ l.n_breakends }}</button>
        {% else %}<span class="text-muted small">1</span>{% endif %}
      </td>
      <td>
        {% if rx.has_igv and (l.igv.html_a or l.igv.html_b) %}
          <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 tx-igv-btn"
                  data-event-id="{{ l.igv.event_id }}" data-point-a="{{ l.igv.point_a }}" data-point-b="{{ l.igv.point_b }}"
                  data-label-a="{{ l.igv.label_a }}" data-label-b="{{ l.igv.label_b }}"
                  data-html-a="{{ l.igv.html_a or '' }}" data-html-b="{{ l.igv.html_b or '' }}">IGV</button>
        {% endif %}
      </td>
      <td>
        <strong>{{ l.anchor_gene }}</strong> <span class="text-muted small">{{ l.anchor_band }}{% if l.anchor_ig %} &middot; {{ l.anchor_ig }}{% endif %}</span>
        <div class="small text-muted">{{ l.anchor_label }}</div>
      </td>
      <td>
        <strong>{{ l.partner_gene }}</strong> <span class="text-muted small">{{ l.partner_band }}{% if l.partner_ig %} &middot; {{ l.partner_ig }}{% endif %}</span>
        <div class="small text-muted">{{ l.partner_label }}</div>
      </td>
      <td>
        {% if l.known_pair %}<strong>{{ l.known_pair }}</strong>{% endif %}
        {% if l.tier %}<span class="badge {{ 'bg-danger' if l.tier.startswith('defining') else ('bg-warning text-dark' if l.tier.startswith('secondary') else 'bg-secondary') }} ms-1">{{ l.tier }}</span>{% endif %}
        {% if l.entity %}<div class="small text-muted">{{ l.entity }}{% if l.known_freq %} &middot; {{ l.known_freq }}{% endif %}</div>{% endif %}
      </td>
      <td class="text-end">{{ l.reads if l.reads is not none else '' }}</td>
      <td>{{ l.n_callers }} <span class="small text-muted">{{ l.callers | join(', ') }}</span></td>
      <td><code class="small">{{ l.worst_filter }}</code></td>
      <td>
        {% if l.nano == 'yes' %}<span class="badge bg-success">confirmed</span>
        {% elif l.nano == 'no' and l.nano_filter %}<span class="badge bg-warning text-dark" title="nanomonsv saw it and rejected it">{{ l.nano_filter }}</span>
        {% elif l.nano == 'no' %}<span class="badge bg-secondary">not reported</span>{% endif %}
        {% if l.nano_reads %}<div class="small text-muted">{{ l.nano_reads }} reads</div>{% endif %}
      </td>
      <td>{% if l.flag %}<span class="badge border text-warning border-warning bg-transparent" title="{{ l.flag }}" style="cursor:help">flag</span>{% endif %}</td>
      <td class="text-center">
        <input type="checkbox" class="form-check-input rx-include" title="include in the Reporting tab"
               data-rx-key="{{ l.key }}" data-reportable="{{ 1 if l.reportable else 0 }}"
               data-anchor="{{ l.anchor_gene }} {{ l.anchor_band }}{% if l.anchor_ig %} {{ l.anchor_ig }}{% endif %}"
               data-partner="{{ l.partner_gene }} {{ l.partner_band }}{% if l.partner_ig %} {{ l.partner_ig }}{% endif %}"
               data-pair="{{ l.known_pair }}" data-tier="{{ l.tier }}"
               data-reads="{{ l.reads if l.reads is not none else '' }}" data-callers="{{ l.callers | join(', ') }}"
               data-nano="{{ 'confirmed' if l.nano == 'yes' else (l.nano_filter or ('not reported' if l.nano == 'no' else '')) }}"
               data-point-a="{{ l.igv.point_a }}" data-point-b="{{ l.igv.point_b }}">
      </td>
    </tr>
    <tr class="rx-detail" data-rx-detail="{{ lid }}" style="display:none">
      <td></td>
      <td colspan="10" class="bg-white small">
        <div class="row g-2">
          <div class="col-md-6">
            <table class="table table-sm table-borderless mb-0 small">
              {% for k, v in l.detail %}
                <tr><td class="text-muted text-nowrap pe-3"{% if rx.detail_key_map and k in rx.detail_key_map %} title="{{ rx.detail_key_map[k] }}" style="cursor:help;text-decoration:underline dotted"{% endif %}>{{ k }}</td><td style="overflow-wrap:anywhere">{{ v }}</td></tr>
              {% endfor %}
            </table>
          </div>
          <div class="col-md-6 text-muted">
            <p class="mb-1"><strong>Breakend A</strong> {{ l.igv.point_a }} ({{ l.igv.label_a }})<br><strong>Breakend B</strong> {{ l.igv.point_b }} ({{ l.igv.label_b }})</p>
            {% if l.flag %}<p class="mb-1"><strong>Flag:</strong> {{ l.flag }}</p>{% endif %}
            {% if l.entity %}<p class="mb-1"><strong>Entity:</strong> {{ l.entity }}{% if l.known_freq %} &middot; published frequency {{ l.known_freq }}{% endif %}</p>{% endif %}
            <p class="mb-0">These fields belong to the breakend with the most supporting reads in this locus. Read counts per caller are taken from each caller's own output, not from the merged record. Hover a field name for its meaning, or open the Detail field key above the table.</p>
          </div>
        </div>
      </td>
    </tr>
    {% if l.n_breakends > 1 %}
      {% for m in l.members %}
        <tr class="rx-member table-secondary" data-rx-parent="{{ lid }}" style="display:none">
          <td></td>
          <td>
            {% if rx.has_igv and (m.igv.html_a or m.igv.html_b) %}
              <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 tx-igv-btn"
                      data-event-id="{{ m.igv.event_id }}" data-point-a="{{ m.igv.point_a }}" data-point-b="{{ m.igv.point_b }}"
                      data-label-a="{{ m.igv.label_a }}" data-label-b="{{ m.igv.label_b }}"
                      data-html-a="{{ m.igv.html_a or '' }}" data-html-b="{{ m.igv.html_b or '' }}">IGV</button>
            {% endif %}
          </td>
          <td class="small ps-4">{{ m.achrom }}:{{ '{:,}'.format(m.apos) }} <span class="text-muted">{{ m.aig }}</span></td>
          <td class="small">{{ m.pchrom }}:{{ '{:,}'.format(m.ppos) }} <span class="text-muted">{{ m.pgene }} {{ m.pig }}</span></td>
          <td class="small text-muted">{{ m.sv_id }}</td>
          <td class="text-end small">{{ m.reads if m.reads is not none else '' }}</td>
          <td class="small">{{ m.callers | length }} <span class="text-muted">{{ m.callers | join(', ') }}</span></td>
          <td><code class="small">{{ m.worst_filter }}</code></td>
          <td class="small">{{ 'confirmed' if m.nano_conf == 'yes' else (m.nano_filter or ('not reported' if m.nano_conf == 'no' else '')) }}</td>
          <td>{% if m.flag %}<span class="badge border text-warning border-warning bg-transparent" title="{{ m.flag }}" style="cursor:help">flag</span>{% endif %}</td>
          <td></td>
        </tr>
      {% endfor %}
    {% endif %}
  {% endmacro %}

  {% macro render_table(groups, table_id, title, subtitle) %}
    <h6 class="mt-3 mb-1">{{ title }} <span class="text-muted small fw-normal">{{ subtitle }}</span></h6>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle rx-table" id="{{ table_id }}">
        <thead>
          <tr>
            <th title="breakends in this locus">#</th><th></th>
            <th>Anchor</th><th>Partner</th><th>Named pair / tier</th>
            <th class="text-end">Reads</th><th>Callers</th><th>Worst filter</th><th>nanomonsv</th><th>Flag</th>
            <th title="tick to include this locus in the Reporting tab">Include</th>
          </tr>
        </thead>
        <tbody>
          {% set ns = namespace(i=0) %}
          {% for g in groups %}
            {% if g.n_loci > 1 and g.anchor %}
              <tr class="rx-group table-light" data-rx-group="{{ table_id }}-g{{ loop.index }}">
                <td colspan="11" class="small">
                  <strong>{{ g.anchor_display }} event group</strong> &middot; {{ g.n_loci }} partner loci
                  {% if g.anchor == 'MYC' %}<span class="text-muted">&middot; MYC is commonly rearranged with several partners at once; read the loci together</span>{% endif %}
                </td>
              </tr>
            {% endif %}
            {% for l in g.loci %}
              {% set ns.i = ns.i + 1 %}
              {{ locus_row(l, g, table_id, ns.i) }}
            {% endfor %}
          {% endfor %}
          {% if not groups %}
            <tr><td colspan="11" class="text-muted small">none</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endmacro %}

  {{ render_table(rx.reportable, 'rx-reportable', 'Reportable rearrangements', 'anchored to an Ig locus or MYC, or a named myeloma pair; A::B and B::A are one row') }}

  <details class="mt-3" id="rx-other-details">
    <summary class="small">Other junctions &mdash; {{ rx.other | map(attribute='n_loci') | sum }} partner loci, not reportable (flagged, or neither anchored nor named)</summary>
    {{ render_table(rx.other, 'rx-other', 'Other junctions', 'unknown significance') }}
  </details>

  {% if rx.other_svs %}
    <details class="mt-3">
      <summary class="small">Graded intrachromosomal variants (DEL / INS / INV / DUP with a tier) &mdash; {{ rx.other_svs | length }}</summary>
      <table class="table table-sm small mt-2">
        <thead><tr><th>ID</th><th>Type</th><th>Locus</th><th>Genes</th><th>Named</th><th>Tier</th><th>Reads</th><th>Callers</th><th>Filter</th></tr></thead>
        <tbody>
          {% for v in rx.other_svs %}
            <tr><td>{{ v.sv_id }}</td><td>{{ v.sv_type }}</td><td>{{ v.locus }}</td><td>{{ v.genes }}</td><td>{{ v.known_pair }}</td><td>{{ v.tier }}</td><td>{{ v.reads }}</td><td>{{ v.callers }}</td><td><code>{{ v.filter }}</code></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
  {% endif %}

  {# Paired-breakpoint IGV viewer, unchanged from the previous tab. #}
  <div class="modal fade" id="tx-igv-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title mb-0" id="tx-igv-title">Breakpoint view</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0">
          <div class="row g-0 h-100">
            <div class="col-6 border-end d-flex flex-column">
              <div class="px-3 py-1 bg-light border-bottom small">
                <strong id="tx-igv-head-a">Breakpoint A</strong>
                <span class="text-muted ms-2" id="tx-igv-locus-a"></span>
                <a class="ms-2" id="tx-igv-open-a" target="_blank" rel="noopener">open</a>
              </div>
              <iframe id="tx-igv-frame-a" class="flex-grow-1 border-0" style="min-height:70vh" src="about:blank"></iframe>
            </div>
            <div class="col-6 d-flex flex-column">
              <div class="px-3 py-1 bg-light border-bottom small">
                <strong id="tx-igv-head-b">Breakpoint B</strong>
                <span class="text-muted ms-2" id="tx-igv-locus-b"></span>
                <a class="ms-2" id="tx-igv-open-b" target="_blank" rel="noopener">open</a>
              </div>
              <iframe id="tx-igv-frame-b" class="flex-grow-1 border-0" style="min-height:70vh" src="about:blank"></iframe>
            </div>
          </div>
          <div id="tx-igv-missing" class="alert alert-warning m-3 d-none">
            No IGV page was found for this event.
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var view = 'reportable', minCallers = 1, minReads = 0;

    function applyFilters() {
      var shown = 0;
      document.querySelectorAll('#tab-translocations tr.rx-locus').forEach(function (tr) {
        var ok = true;
        var rep = tr.getAttribute('data-reportable') === '1';
        // The "Reportable" view is the split between the two tables, not a
        // row filter: rows in the Other table stay visible when that
        // section is opened.
        if (view === 'reportable') { ok = rep || !!tr.closest('#rx-other'); }
        else if (view === 'defining') { ok = tr.getAttribute('data-defining') === '1'; }
        else if (view === 'confirmed') { ok = tr.getAttribute('data-confirmed') === '1'; }
        if (ok && parseInt(tr.getAttribute('data-callers'), 10) < minCallers) { ok = false; }
        if (ok && parseInt(tr.getAttribute('data-reads'), 10) < minReads) { ok = false; }
        tr.style.display = ok ? '' : 'none';
        if (!ok) {
          var t = tr.querySelector('.rx-toggle');
          if (t) { hideMembers(t.getAttribute('data-rx-target')); }
          var d = document.querySelector('tr.rx-detail[data-rx-detail="' + tr.getAttribute('data-rx-id') + '"]');
          if (d) { d.style.display = 'none'; }
        }
        if (ok && !(view === 'reportable' && tr.closest('#rx-other'))) { shown += 1; }
      });
      // group header rows: hide when none of their loci are visible
      document.querySelectorAll('#tab-translocations tr.rx-group').forEach(function (g) {
        var next = g.nextElementSibling, any = false;
        while (next && !next.classList.contains('rx-group')) {
          if (next.classList.contains('rx-locus') && next.style.display !== 'none') { any = true; break; }
          next = next.nextElementSibling;
        }
        g.style.display = any ? '' : 'none';
      });
      // when a non-reportable view is chosen, open the "other" section
      var other = document.getElementById('rx-other-details');
      if (other && view !== 'reportable') { other.open = true; }
      var c = document.getElementById('rx-count');
      if (c) { c.textContent = shown + ' loci shown'; }
    }
    function hideMembers(id) {
      document.querySelectorAll('tr.rx-member[data-rx-parent="' + id + '"]').forEach(function (m) { m.style.display = 'none'; });
    }
    document.querySelectorAll('#rx-filters [data-rx-view]').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('#rx-filters [data-rx-view]').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active'); view = b.getAttribute('data-rx-view'); applyFilters();
      });
    });
    document.querySelectorAll('#rx-min-callers button').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('#rx-min-callers button').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active'); minCallers = parseInt(b.getAttribute('data-rx-min'), 10); applyFilters();
      });
    });
    document.querySelectorAll('#rx-min-reads button').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('#rx-min-reads button').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active'); minReads = parseInt(b.getAttribute('data-rx-min'), 10); applyFilters();
      });
    });
    document.addEventListener('click', function (e) {
      if (e.target.closest && (e.target.closest('button') || e.target.closest('a') || e.target.closest('input') || e.target.closest('label'))) { return; }
      var row = e.target.closest ? e.target.closest('tr.rx-locus') : null;
      if (!row) { return; }
      var d = document.querySelector('tr.rx-detail[data-rx-detail="' + row.getAttribute('data-rx-id') + '"]');
      if (d) { d.style.display = d.style.display === 'none' ? '' : 'none'; }
    });
    document.addEventListener('click', function (e) {
      var t = e.target.closest ? e.target.closest('.rx-toggle') : null;
      if (!t) { return; }
      var id = t.getAttribute('data-rx-target');
      var rows = document.querySelectorAll('tr.rx-member[data-rx-parent="' + id + '"]');
      var open = rows.length && rows[0].style.display === 'none';
      rows.forEach(function (m) { m.style.display = open ? '' : 'none'; });
      t.innerHTML = (open ? '&#9660; ' : '&#9654; ') + t.textContent.replace(/[^0-9]/g, '');
    });
    applyFilters();

    // rx_include_v1: Include checkboxes, backed by the Reporting store.
    // rx_include_v2: this inline script runs before variant-browser.js
    // (loaded at the end of body) defines the store, and before
    // $(document).ready sets its sample, so the wiring waits for load.
    window.addEventListener('load', function () {
      var store = window.tspipeReporting;
      if (!store) { return; }
      function snapshotOf(box) {
        return {
          anchor: box.getAttribute('data-anchor') || '', partner: box.getAttribute('data-partner') || '',
          pair: box.getAttribute('data-pair') || '', tier: box.getAttribute('data-tier') || '',
          reads: box.getAttribute('data-reads') || '', callers: box.getAttribute('data-callers') || '',
          nano: box.getAttribute('data-nano') || '',
          point_a: box.getAttribute('data-point-a') || '', point_b: box.getAttribute('data-point-b') || '',
          reportable: box.getAttribute('data-reportable') === '1'
        };
      }
      function sync() {
        var ids = {};
        store.load().forEach(function (it) { if (it.kind === 'rearrangement') { ids[it.id] = true; } });
        document.querySelectorAll('.rx-include').forEach(function (box) {
          var on = !!ids[box.getAttribute('data-rx-key')];
          if (box.checked !== on) { box.checked = on; }
        });
      }
      document.addEventListener('change', function (e) {
        var box = e.target.closest ? e.target.closest('.rx-include') : null;
        if (!box) { return; }
        store.toggle('rearrangement', box.getAttribute('data-rx-key'), snapshotOf(box));
      });
      var all = document.getElementById('rx-include-reportable');
      if (all) {
        all.addEventListener('click', function () {
          document.querySelectorAll('.rx-include[data-reportable="1"]').forEach(function (box) {
            if (!box.checked) { store.toggle('rearrangement', box.getAttribute('data-rx-key'), snapshotOf(box)); }
          });
        });
      }
      store.onChange(sync);
      sync();
    });

    // Paired breakpoint viewer
    var modalEl = document.getElementById('tx-igv-modal');
    if (!modalEl) { return; }
    function showEvent(button) {
      var srcA = button.getAttribute('data-html-a') || null;
      var srcB = button.getAttribute('data-html-b') || null;
      document.getElementById('tx-igv-title').textContent =
        button.getAttribute('data-label-a') + '  ::  ' + button.getAttribute('data-label-b') + '   (' + button.getAttribute('data-event-id') + ')';
      document.getElementById('tx-igv-head-a').textContent = button.getAttribute('data-label-a');
      document.getElementById('tx-igv-head-b').textContent = button.getAttribute('data-label-b');
      document.getElementById('tx-igv-locus-a').textContent = button.getAttribute('data-point-a');
      document.getElementById('tx-igv-locus-b').textContent = button.getAttribute('data-point-b');
      var missing = document.getElementById('tx-igv-missing');
      var frameA = document.getElementById('tx-igv-frame-a'), frameB = document.getElementById('tx-igv-frame-b');
      var openA = document.getElementById('tx-igv-open-a'), openB = document.getElementById('tx-igv-open-b');
      if (!srcA && !srcB) {
        missing.classList.remove('d-none'); frameA.src = 'about:blank'; frameB.src = 'about:blank';
        openA.removeAttribute('href'); openB.removeAttribute('href');
      } else {
        missing.classList.add('d-none');
        frameA.src = srcA || 'about:blank'; frameB.src = srcB || 'about:blank';
        if (srcA) { openA.href = srcA; } else { openA.removeAttribute('href'); }
        if (srcB) { openB.href = srcB; } else { openB.removeAttribute('href'); }
      }
    }
    document.addEventListener('click', function (event) {
      var button = event.target.closest ? event.target.closest('.tx-igv-btn') : null;
      if (!button) { return; }
      showEvent(button);
      if (window.bootstrap && bootstrap.Modal) { bootstrap.Modal.getOrCreateInstance(modalEl).show(); }
    });
    modalEl.addEventListener('hidden.bs.modal', function () {
      document.getElementById('tx-igv-frame-a').src = 'about:blank';
      document.getElementById('tx-igv-frame-b').src = 'about:blank';
    });
  })();
  </script>
  {% endif %}
</div>
