{% extends "base.html.j2" %}

{% block title %}Run {{ ctx.run_name }} — cohort{% endblock %}

{% block body %}
<div class="container-fluid py-3 px-4">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h3 class="mb-0">Run {{ ctx.run_name }}</h3>
      <div class="text-muted small">
        {{ ctx.samples | length }} sample(s) &middot; adaptive-sampling nanopore WGS, plasma cell neoplasm panel
        &middot; rearrangements on T2T-CHM13v2.0, copy number and SNVs on GRCh38 &middot; generated {{ ctx.build_time }}
      </div>
    </div>
    <span class="badge bg-secondary fs-6">MM aWGS</span>
  </div>

  <div class="table-responsive">
    <table id="cohort-table" class="table table-sm table-striped table-hover w-100 align-middle">
      <thead>
        <tr>
          <th>Sample</th>
          <th title="from flow cytometry, as supplied on the sample sheet">Purity</th>
          <th title="median on-target depth">Depth</th>
          <th title="from ichorCNA with ploidy pinned at 2; computed, to be confirmed on the genome plot">Ploidy class</th>
          <th title="primary Ig translocation from the dictionary (tier: defining)">Defining translocation</th>
          <th title="a reportable MYC rearrangement is present">MYC</th>
          <th title="nanomonsv-confirmed partner loci">Confirmed</th>
          <th>17p</th><th>1p</th><th>1q</th><th>13q</th>
          <th title="somatic, in-panel, protein-altering">Clinical SNVs</th>
          <th title="sample identity from on-target SNP allele fractions (mmfingerprint), where run">Identity</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for s in ctx.samples %}
          {% set r = s.cohort_row or {} %}
          {% set href = './' ~ s.sample ~ '/' ~ ctx.report_subdir ~ s.sample ~ '_report.html' %}
          <tr{% if r.identity_flag %} class="table-warning"{% endif %}>
            <td><a href="{{ href }}"><strong>{{ s.sample }}</strong></a></td>
            <td>{{ '%.2f'|format(r.purity) if r.purity is not none else '' }}</td>
            <td>{{ '%.0fx'|format(r.depth) if r.depth is not none else '' }}</td>
            <td>
              {% if r.ploidy_class %}
                {% set pc = r.ploidy_class %}
                <span class="badge {{ 'bg-danger' if pc in ('hyperdiploid','hypodiploid') else ('bg-warning text-dark' if pc.startswith('near') else 'bg-secondary') }}">{{ pc.replace('_', '-') }}</span>
                {% if r.trisomies %}<span class="small text-muted">{% for tri in r.trisomies %}+{{ tri | string | replace('chr','') }} {% endfor %}</span>{% endif %}
              {% endif %}
            </td>
            <td>
              {% for d in r.defining %}
                <strong>{{ d.name }}</strong>{% if d.nano == 'yes' %} <span class="badge bg-success">confirmed</span>{% endif %}{% if not loop.last %}, {% endif %}
              {% else %}<span class="text-muted">none</span>{% endfor %}
            </td>
            <td>{% if r.myc_reportable %}<span class="badge bg-warning text-dark">rearranged</span>{% endif %}</td>
            <td>{{ r.n_confirmed if r.n_confirmed is not none else '' }}</td>
            <td>{% if r.arm_17p %}<span class="badge {{ 'bg-danger' if r.arm_17p.startswith('loss') else 'bg-success' }}">{{ r.arm_17p }}</span>{% endif %}</td>
            <td>{% if r.arm_1p %}<span class="badge {{ 'bg-danger' if r.arm_1p.startswith('loss') else 'bg-success' }}">{{ r.arm_1p }}</span>{% endif %}</td>
            <td>{% if r.arm_1q %}<span class="badge {{ 'bg-danger' if r.arm_1q.startswith('loss') else 'bg-success' }}">{{ r.arm_1q }}</span>{% endif %}</td>
            <td>{% if r.arm_13q %}<span class="badge {{ 'bg-danger' if r.arm_13q.startswith('loss') else 'bg-success' }}">{{ r.arm_13q }}</span>{% endif %}</td>
            <td>{{ r.n_clinical if r.n_clinical is not none else '' }}</td>
            <td>
              {% if r.identity_flag %}<span class="badge bg-warning text-dark">mixture?</span>
              {% elif r.identity %}<span class="small text-muted">{{ r.identity }}</span>{% endif %}
            </td>
            <td><a href="{{ href }}" class="btn btn-sm btn-outline-primary">Open &rarr;</a></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="small text-muted mt-2">
    Arm columns show the ichorCNA arm event with copy number and, in brackets, the cell fraction derived from flow purity.
    Empty means no arm-level event was called. Ploidy class is computed and is confirmed on each sample's genome plot.
  </div>
</div>
{% endblock %}

{% block body_scripts %}
<script>
  $(document).ready(function () {
    $('#cohort-table').DataTable({
      pageLength: 50,
      order: [[0, 'asc']],
      dom: 'Bfrtip',
      buttons: [{ extend: 'colvis', text: 'Columns', className: 'btn-sm btn-outline-secondary' }]
    });
  });
</script>
{% endblock %}
