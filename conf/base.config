/*
 * Per-process resource defaults using nf-core-style labels.
 * Modules attach labels like `label 'process_high'` and pick up these defaults.
 * All clamps go through check_max() so the params.max_* ceilings still apply.
 */

process {

    cpus   = { check_max(2,    'cpus'  ) }
    memory = { check_max(8.GB, 'memory') }
    time   = { check_max(4.h,  'time'  ) }

    withLabel: process_low {
        cpus   = { check_max(2,    'cpus'  ) }
        memory = { check_max(4.GB, 'memory') }
        time   = { check_max(2.h,  'time'  ) }
    }
    withLabel: process_medium {
        cpus   = { check_max(16,    'cpus'  ) }
        memory = { check_max(32.GB, 'memory') }
        time   = { check_max(6.h,   'time'  ) }
    }
    withLabel: process_high {
        cpus   = { check_max(32,    'cpus'  ) }
        memory = { check_max(64.GB, 'memory') }
        time   = { check_max(12.h,  'time'  ) }
    }
    withLabel: process_xhigh {
        cpus   = { check_max(64,     'cpus'  ) }
        memory = { check_max(128.GB, 'memory') }
        time   = { check_max(24.h,   'time'  ) }
    }
    withLabel: process_long {
        time   = { check_max(48.h,  'time'  ) }
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                ? params.max_memory as nextflow.util.MemoryUnit
                : obj
        } catch (Exception e) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                ? params.max_time as nextflow.util.Duration
                : obj
        } catch (Exception e) { return obj }
    } else if (type == 'cpus') {
        return Math.min(obj as int, params.max_cpus as int)
    }
}
