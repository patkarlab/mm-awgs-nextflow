/*
 * Test profile: small synthetic inputs for smoke testing.
 * Best combined with `-profile stub` for a full no-real-data dry run.
 */

params {
    sample_sheet = "${projectDir}/tests/sample_sheet_stub.csv"
    outdir       = 'results_test'
    max_cpus     = 4
    max_memory   = '8.GB'
    max_time     = '1.h'
}
