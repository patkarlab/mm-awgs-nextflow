/*
 * Per-process conda/docker assignments. Matches the env activations used
 * in the production bash scripts.
 *
 * Most processes use the 'awgs_sv' conda env (minimap2, samtools, sniffles,
 * cutesv, severus, SURVIVOR, mosdepth, python3 with pysam/cyvcf2).
 *
 * Three processes use docker images that bundle their own runtime:
 *   - CLAIRS_TO   : hkubal/clairs-to:latest        (somatic SNV/indel)
 *   - CLAIR3_PHASED : hkubal/clair3:latest          (phased germline)
 *   - VEP_ANNOTATE_CLAIR3 : ensemblorg/ensembl-vep:release_113.0
 *
 * ICHORCNA uses a different conda env (`ichorCNA`) but does NOT activate it;
 * the script uses absolute paths to the env's binaries
 * (/home/hemat/anaconda3/envs/ichorCNA/bin/{readCounter,Rscript}). The
 * module therefore declares no conda or container directive — the binaries
 * are invoked by full path.
 */

process {

    // ===== T2T track =====
    withName: REALIGN_T2T              { conda = 'awgs_sv' }
    withName: SAMTOOLS_INDEX_T2T       { conda = 'awgs_sv' }
    withName: SNIFFLES                 { conda = 'awgs_sv' }
    withName: CUTESV                   { conda = 'awgs_sv' }
    withName: SEVERUS                  { conda = 'awgs_sv' }
    withName: SURVIVOR_MERGE           { conda = 'awgs_sv' }
    withName: ANNOTATE_MM_TRANSLOCATIONS { conda = 'awgs_sv' }

    // ===== hg38 track =====
    withName: REALIGN_HG38             { conda = 'awgs_sv' }
    withName: SAMTOOLS_INDEX_HG38      { conda = 'awgs_sv' }

    withName: CLAIRS_TO {
        container = params.clairs_to_image
        containerOptions = { "--user \$(id -u):\$(id -g) -v /goast:/goast" }
    }

    // ICHORCNA: no conda/container — uses absolute paths to ichorCNA env binaries.
    // No directive needed here.

    withName: CLAIR3_PHASED {
        container = params.clair3_image
        // Bind /goast (BAMs, refs, model files) AND /home/hemat (model fallback).
        containerOptions = { "--user \$(id -u):\$(id -g) -v /goast:/goast -v ${System.getenv('HOME')}:${System.getenv('HOME')}" }
    }

    withName: VEP_ANNOTATE_CLAIR3 {
        // Two-stage process: bcftools/tabix (conda awgs_sv) for pre/post,
        // VEP (docker) for the annotation step itself. We declare the conda
        // env here; the docker invocation is inline in the script body
        // (matches the production bash, which also nests `docker run` inside
        // a conda-activated shell).
        conda = 'awgs_sv'
    }
}
