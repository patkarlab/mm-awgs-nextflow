/*
 * Per-process conda/docker assignments.
 *
 * IMPORTANT — pointing at EXISTING conda envs:
 *   When Nextflow's `conda` directive is given a name like 'awgs_sv', Nextflow
 *   treats it as a PACKAGE name and tries to create a fresh env containing
 *   that package. That fails because awgs_sv is not a published package; it
 *   is the name of a curated env that already exists on the host.
 *
 *   Fix: give `conda` the absolute PREFIX PATH to the existing env. When the
 *   directive resolves to an existing directory, Nextflow uses it directly
 *   without trying to create anything.
 *
 *   The prefix path is `params.conda_awgs_sv` (see nextflow.config), default
 *   `/home/hemat/anaconda3/envs/awgs_sv`. Override on other servers with
 *   `--conda_awgs_sv /path/to/your/env`.
 *
 * Processes that need bundled tooling (ClairS-TO, Clair3, VEP) invoke
 * `docker run ...` INLINE in their script bodies (matching the production
 * bash). They do NOT use Nextflow's `container` directive — that would lead
 * to docker-in-docker. They still set `conda` to `params.conda_awgs_sv`
 * because the script body uses bcftools/tabix/samtools from the host env to
 * pre- and post-process around the docker call.
 *
 * ICHORCNA uses a different conda env (`ichorCNA`) but does NOT activate it;
 * the script body uses absolute paths to that env's binaries
 * (/home/hemat/anaconda3/envs/ichorCNA/bin/{readCounter,Rscript}). The
 * module therefore declares no conda directive at all.
 */

process {

    // ===== Input prep =====
    withName: MERGE_MINKNOW             { conda = params.conda_awgs_sv }
    withName: BAF_LOH_SCREEN            { conda = params.conda_awgs_sv }
    withName: BAF_CN_PLOTS              { conda = params.conda_awgs_sv }

    // ===== Reporting =====
    // The dashboard builder needs jinja2, pandas, beautifulsoup4 and requests
    // in addition to the pipeline's usual tooling.
    withName: REPORT_BUNDLE             { conda = params.conda_awgs_sv }
    withName: DASHBOARD                 { conda = params.conda_awgs_sv }
    // create_report comes from igv-reports in this environment. Without
    // the directive the process ran with no environment at all and could
    // not find it, so IGV_SNAPSHOTS has never succeeded under the
    // pipeline; it worked only when run by hand with awgs_sv active.
    withName: IGV_SNAPSHOTS             { conda = params.conda_awgs_sv }

    // ===== T2T track =====
    withName: REALIGN_T2T               { conda = params.conda_awgs_sv }
    withName: SNIFFLES                  { conda = params.conda_awgs_sv }
    withName: CUTESV                    { conda = params.conda_awgs_sv }
    withName: SEVERUS                   { conda = params.conda_awgs_sv }
    withName: SURVIVOR_MERGE            { conda = params.conda_awgs_sv }
    withName: ANNOTATE_MM_TRANSLOCATIONS { conda = params.conda_awgs_sv }

    // ===== hg38 track =====
    withName: REALIGN_HG38              { conda = params.conda_awgs_sv }

    // CLAIRS_TO calls `docker run hkubal/clairs-to:latest ...` inline; the
    // conda env supplies bcftools for the post-run variant-count check.
    withName: CLAIRS_TO                 { conda = params.conda_awgs_sv }

    // ICHORCNA: no conda/container — absolute paths to /home/hemat/anaconda3/envs/ichorCNA/bin/.

    // CLAIR3_PHASED calls `docker run hkubal/clair3:latest ...` inline; the
    // conda env supplies samtools/bcftools/tabix for pre/post processing.
    withName: CLAIR3_PHASED             { conda = params.conda_awgs_sv }

    // VEP_ANNOTATE_CLAIR3 calls `docker run ensemblorg/ensembl-vep:release_113.0 ...`
    // inline; conda supplies bcftools, tabix, and awk for the surrounding pipeline.
    withName: VEP_ANNOTATE_CLAIR3       { conda = params.conda_awgs_sv }
    withName: FILTER_V6_REPORT          { conda = params.conda_awgs_sv }
}
