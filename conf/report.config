/*
 * Report and IGV configuration.
 *
 * Merge these blocks into nextflow.config (params) and conf/modules.config
 * (process). They are kept in one file here so the additions are reviewable
 * as a unit before being split.
 */

params {
    // ---- IGV snapshots -------------------------------------------------
    skip_igv           = false

    // Bases of context either side of each site.
    igv_flanking       = 5000

    // sv_type values rendered as breakpoint pages. The annotated table is
    // annotation over the whole merged callset, so without this every
    // deletion and insertion would get a page pair: on a typical sample that
    // is ~1,400 pages and gigabytes of embedded alignment data instead of ~76.
    igv_sv_types       = 'TRA'

    // Minimum caller count. Deliberately 1. Single-caller rearrangements at
    // low read support are the calls this panel exists to recover; the
    // FISH-concordant t(11;14) results in this project came from one caller
    // at RE=2. Raising this is a per-run decision, not a default.
    igv_min_callers    = 1

    // Cap on events rendered, highest supporting-read count first.
    igv_max_events     = 200

    // ---- Report --------------------------------------------------------
    skip_report        = false

    // Inline the breakpoint pages for the first N events as data URIs, so
    // the paired viewer works from the report file alone. 0 keeps reports
    // small (~2.5 MB); the archive carries igv/ anyway, so this only earns
    // its cost when a single report HTML travels detached from its folder.
    report_embed_igv   = 0

    // --light drops igv/ from the archive. It is refused when the reports
    // contain IGV controls, since that ships buttons that open empty panes;
    // report_zip_force overrides once the recipient has been told.
    report_zip_light   = false
    report_zip_force   = false
}

process {

    withName: 'IGV_SNAPSHOTS' {
        // meta.id in the path keeps cohort runs from colliding on a shared
        // output directory.
        publishDir = [
            path:    { "${params.outdir}/igv" },
            mode:    'copy',
            saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REPORT_BUNDLE' {
        publishDir = [
            path:    { "${params.outdir}/.." },
            mode:    'copy',
            saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DASHBOARD' {
        publishDir = [ enabled: false ]
    }

    withName: 'EMBED_REPORT_ASSETS' {
        publishDir = [
            path:    { "${params.outdir}/.." },
            mode:    'copy',
            saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REPORT_ZIP' {
        publishDir = [
            path:    { "${params.outdir}/.." },
            mode:    'copy',
            pattern: '*.zip'
        ]
    }
}
