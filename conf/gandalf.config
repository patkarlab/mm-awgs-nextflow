/*
 * Gandalf-specific configuration.
 *
 * Critical: /home/hemat is 98% full. Nextflow's default workDir is $PWD/work,
 * which would land on /home/hemat. Override to /goast (2.8T available).
 */

workDir = '/goast/mm-awgs-nextflow/work'

process {
    executor = 'local'
}

executor {
    // gandalf has 192 cores and 1511 GB. These were previously declared as 64
    // and 128 GB, which is what Nextflow schedules against: tasks queued
    // against a budget far smaller than the hardware, and a process_high task
    // could sit unsubmitted while the machine ran at 10 percent of capacity.
    // Headroom is left deliberately for the OS and other users.
    cpus   = 180
    memory = '1200.GB'
    name   = 'local'
}

params {
    // Gandalf-specific resource ceilings. check_max() in conf/base.config
    // clamps every per-label request to these, so they must track the
    // executor block above or labels are silently capped.
    max_cpus   = 180
    max_memory = '1200.GB'
    max_time   = '72.h'
}

// Default to running with both conda and docker available
conda.enabled   = true
docker.enabled  = true

// Keep any Nextflow-created conda envs off the full /home/hemat partition.
// (For pre-existing envs referenced by absolute prefix this isn't used;
// it only matters if a future module specifies a package list and Nextflow
// has to build a fresh env.)
conda.cacheDir = '/goast/mm-awgs-nextflow/work/conda_cache'
