/*
 * Gandalf-specific configuration.
 *
 * Critical: /home/hemat is 98% full. Nextflow's default workDir is $PWD/work,
 * which would land on /home/hemat. Override to /goast (2.8T available).
 */

workDir = '/goast/nikhil_awgs_testing/nextflow_work'

process {
    executor = 'local'
}

executor {
    cpus   = 64
    memory = '128.GB'
    name   = 'local'
}

params {
    // Gandalf-specific resource ceilings — the box has plenty of headroom
    max_cpus   = 64
    max_memory = '128.GB'
    max_time   = '72.h'
}

// Default to running with both conda and docker available
conda.enabled   = true
docker.enabled  = true
docker.userEmulation = true
